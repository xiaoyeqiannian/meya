<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Meya.UI.ViewModels"
        xmlns:views="using:Meya.UI.Views"
        x:Class="Meya.UI.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Width="440"
        Height="96"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SystemDecorations="None"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">
  <Border Padding="8,7,14,7"
          CornerRadius="18"
          ClipToBounds="True"
          Background="#EB202329"
          BorderBrush="#703FE8D0"
          BorderThickness="1">
    <Grid ColumnDefinitions="76,*" ColumnSpacing="10">
      <views:MayaMascotView x:Name="MascotView"
                             Grid.Column="0"
                             Width="70"
                             Height="70"
                             UseLayoutRounding="False"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="3" VerticalAlignment="Center">
        <TextBlock Grid.Row="0"
                   IsVisible="{Binding HasStatus}"
                   Text="{Binding Status}"
                   Foreground="#BEE8EFF3"
                   FontSize="10.5"
                   FontWeight="Medium"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   MaxLines="1" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Text}"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="NoWrap"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Border>
</Window>
